# 복사해서 .env 로: cp .env.example .env  (.env 는 커밋 금지)
PORT=4500
# 외부 접근 공개 URL (ngrok/cloudflared 등). 승인 링크/대시보드 공유에 사용
PUBLIC_URL=http://localhost:4500

# 알림 채널: console(기본, 로그) | kakao(REST 나에게 보내기 스탠드얼론)
# 실제 카카오톡 승인은 Claude가 PlayMCP로 처리(권장) → 보통 console 로 둠
NOTIFY_CHANNEL=console

# NOTIFY_CHANNEL=kakao 일 때만 필요
KAKAO_ACCESS_TOKEN=
# 아래 둘을 채우면 access token 만료(401) 시 자동 갱신 (Kakao Developers > 내 앱)
KAKAO_REST_API_KEY=
KAKAO_REFRESH_TOKEN=
