# 복사해서 .env 로: cp .env.example .env  (.env 는 커밋 금지)
PORT=4500
# 외부 접근 공개 URL (cloudflared 등). 카카오 승인 링크에 사용 — scripts/tunnel.sh 참고
PUBLIC_URL=http://localhost:4500

# 카카오 발송/수신은 Claude(헤드리스 루프)가 PlayMCP로 처리한다 (REST 미사용).
# 이 매니저는 원장 + SSE(공룡 펫) + 대시보드 역할만 하므로 카카오 토큰은 필요 없다.

# 개발 루프 주기(초). scheduler.sh / launchd 에서 사용. 기본 3600(1시간).
DEV_LOOP_INTERVAL=3600

# 승인 보안 토큰 (공개 터널 사용 시 필수). 설정하면 approve/decline 호출에
# ?token=<값> 이 없으면 거부된다. 매니저가 링크에 토큰을 박아서 내려준다.
# 생성: openssl rand -hex 16
APPROVAL_TOKEN=
