# 복사해서 .env 로: cp .env.example .env  (.env 는 커밋 금지)
PORT=4500
# 외부에서 접근 가능한 공개 URL (ngrok/cloudflared 등). 카카오 승인 링크/텔레그램 webhook에 사용
PUBLIC_URL=http://localhost:4500

# telegram | kakao
NOTIFY_CHANNEL=telegram

# ── Telegram (양방향 권장) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Kakao 나에게 보내기 (아웃바운드) ──
KAKAO_ACCESS_TOKEN=
